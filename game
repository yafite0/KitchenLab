function generateRandomGuest() {
    const idx = Math.floor(Math.random() * RECIPES.length);
    const dish = RECIPES[idx];
    return {
        dishId: dish.id,
        dishName: dish.nameCN,
        immersiveName: dish.nameImmersive
    };
}

function generateCustomerBatch(count) {
    const batch = [];
    for (let i = 0; i < count; i++) {
        batch.push(generateRandomGuest());
    }
    return batch;
}

function updateQueueDisplay() {
    queueCount.innerText = customerQueue.length;
    if (customerQueue.length === 0 && !guestTimeout) {
        clearGuestDisplay();
    }
}

function takeNextCustomer() {
    if (customerQueue.length === 0) {
        alert('暂时没有客人，请稍等');
        return null;
    }
    const next = customerQueue.shift();
    saveGame();
    updateQueueDisplay();
    return next;
}

function spawnCustomer() {
    if (customerQueue.length < GAME_CONFIG.customerSpawn.maxQueueSize) {
        customerQueue.push(generateRandomGuest());
        saveGame();
        updateQueueDisplay();
    }
}

function initCustomerQueue() {
    const lastLogin = localStorage.getItem(SAVE_KEYS.lastLoginTime);
    const now = Date.now();
    
    if (lastLogin) {
        const minutesOffline = (now - parseInt(lastLogin)) / (1000 * 60);
        if (minutesOffline >= GAME_CONFIG.customerSpawn.offlineThresholdMinutes) {
            customerQueue = generateCustomerBatch(GAME_CONFIG.customerSpawn.maxQueueSize);
        } else {
            const accumulated = Math.floor(minutesOffline / GAME_CONFIG.customerSpawn.intervalMinutes);
            const count = Math.min(accumulated, GAME_CONFIG.customerSpawn.maxQueueSize);
            customerQueue = generateCustomerBatch(count);
        }
    } else {
        customerQueue = generateCustomerBatch(3);
    }
    
    localStorage.setItem(SAVE_KEYS.lastLoginTime, now.toString());
    updateQueueDisplay();
}

function startSpawnTimer() {
    if (spawnInterval) clearInterval(spawnInterval);
    spawnInterval = setInterval(() => {
        spawnCustomer();
    }, GAME_CONFIG.customerSpawn.intervalMinutes * 60 * 1000);
}

