function renderInventory() {
    let html = '';
    let totalValue = 0;
    for (let ingId in INGREDIENTS) {
        const ing = INGREDIENTS[ingId];
        const qty = inventory[ingId] || 0;
        if (qty === 0) continue;
        const stdWeight = ITEM_WEIGHT[ingId] || 100;
        const totalWeight = qty * stdWeight;
        const basePrice = getIngredientBasePrice(ingId);
        const value = qty * basePrice * 10;
        totalValue += value;
        html += `<div class="inventory-item">
            <span>${ing.emoji}</span>
            <span>${getIngredientName(ingId)}</span>
            <span class="count">${qty}个</span>
            <span style="font-size:12px;">≈${totalWeight}g</span>
        </div>`;
    }
    inventoryGrid.innerHTML = html || '<div style="color:#aaa;padding:8px;">仓库空空如也</div>';
    totalInventoryValue.innerText = `总价值: ${totalValue} ${getCurrencyName()}`;
}

function refreshMerchantPrices() {
    const { period } = getCurrentTime();
    for (let ingId in INGREDIENTS) {
        const basePrice = getIngredientBasePrice(ingId);
        const fluctuation = 0.9 + Math.random() * 0.2;
        merchantPrices[ingId] = Math.round(basePrice * 10 * fluctuation * GAME_CONFIG.purchaseQuantity);
    }
    currentPricePeriod = period;
}

function renderMerchant() {
    let html = '';
    for (let ingId in INGREDIENTS) {
        const ing = INGREDIENTS[ingId];
        const price = merchantPrices[ingId] || 0;
        const canAfford = gold >= price;
        const disabledClass = canAfford ? '' : 'disabled';
        html += `<div class="merchant-item ${disabledClass}" data-ing-id="${ingId}" data-price="${price}">
            <span>${ing.emoji}</span>
            <span>${getIngredientName(ingId)} x5</span>
            <span class="price">${price}💰</span>
        </div>`;
    }
    merchantGrid.innerHTML = html;
    
    document.querySelectorAll('.merchant-item').forEach(item => {
        if (item.classList.contains('disabled')) return;
        item.addEventListener('click', () => {
            const ingId = item.dataset.ingId;
            const price = parseInt(item.dataset.price);
            if (gold < price) return;
            
            gold -= price;
            inventory[ingId] = (inventory[ingId] || 0) + GAME_CONFIG.purchaseQuantity;
            
            saveGame();
            updateStatusBar();
            renderInventory();
            renderMerchant();
            checkShortage();
        });
    });
}

