function findRecipe(id) {
    return RECIPES.find(r => r.id === id);
}

function getIngredientName(ingId) {
    const ing = INGREDIENTS[ingId];
    if (!ing) return ingId;
    return immersiveMode ? ing.nameIM : ing.nameCN;
}

function getDisplayName(recipe) {
    return immersiveMode ? recipe.nameImmersive : recipe.nameCN;
}

function getCurrencyName() {
    return immersiveMode ? GAME_CONFIG.currencyName.immersive : GAME_CONFIG.currencyName.normal;
}

function getCurrentTime() {
    const now = new Date();
    const utc = now.getTime() + (now.getTimezoneOffset() * 60000);
    const beijingTime = new Date(utc + (8 * 60 * 60 * 1000));
    return {
        hour: beijingTime.getHours(),
        minute: beijingTime.getMinutes(),
        period: beijingTime.getHours() < 12 ? 'morning' : 'afternoon',
        dateStr: beijingTime.toISOString().split('T')[0],
        timestamp: beijingTime.getTime()
    };
}

function isBusinessHours() {
    const { hour } = getCurrentTime();
    return hour >= GAME_CONFIG.businessHours.start && hour < GAME_CONFIG.businessHours.end;
}

function getIngredientBasePrice(ingId) {
    return INGREDIENT_BASE_PRICE[ingId] || 5;
