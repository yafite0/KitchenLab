function setMainAmountsRandom(recipe) {
    // 随机设置主料值 (最小值的1.1倍到最大值的0.9倍之间，避免极端)
    recipe.main.forEach(item => {
        const min = item.target * 0.5;
        const max = item.target * 2.0;
        // 随机在 min*1.1 到 max*0.9 之间，避免太极端
        const randomMin = min * 1.1;
        const randomMax = max * 0.9;
        currentMainAmounts[item.ingId] = Math.round((Math.random() * (randomMax - randomMin) + randomMin) * 10) / 10;
    });
}

function calcTotalMainWeight(recipe) {
    let total = 0;
    recipe.main.forEach(item => {
        total += currentMainAmounts[item.ingId] || 0;
    });
    return Math.round(total * 10) / 10;
}

function getSaltMinMax(recipe, total) {
    return {
        min: total * recipe.saltRange[0],
        max: total * recipe.saltRange[1]
    };
}

function updateSaltSlider() {
    const recipe = findRecipe(selectedDishId);
    if (!recipe) return;
    const total = calcTotalMainWeight(recipe);
    const { min, max } = getSaltMinMax(recipe, total);
    const buffer = 0.5;
    saltSlider.min = Math.max(0, min - buffer);
    saltSlider.max = max + buffer;
    
    // 如果当前盐值超出新范围，拉回边界
    if (currentSalt < saltSlider.min) currentSalt = saltSlider.min;
    if (currentSalt > saltSlider.max) currentSalt = saltSlider.max;
    
    saltSlider.value = currentSalt;
    saltValueDisplay.innerText = currentSalt.toFixed(1);
    saltRangeHint.innerText = `(${min.toFixed(1)}-${max.toFixed(1)})`;
    totalMainWeightSpan.innerText = `食材总重: ${total}g`;
}

function resetSaltToMid() {
    const recipe = findRecipe(selectedDishId);
    if (!recipe) return;
    const total = calcTotalMainWeight(recipe);
    const { min, max } = getSaltMinMax(recipe, total);
    currentSalt = (min + max) / 2;
    updateSaltSlider();
}

function calculateScore(recipe) {
    const totalActual = calcTotalMainWeight(recipe);
    if (totalActual === 0) return 0;
    
    // 计算目标总重和主料得分
    const totalTarget = recipe.main.reduce((acc, item) => acc + item.target, 0);
    let mainScore = 0;
    let deviations = [];
    
    recipe.main.forEach(item => {
        const targetRatio = item.target / totalTarget;
        const actualRatio = (currentMainAmounts[item.ingId] || 0) / totalActual;
        const deviation = Math.abs(actualRatio - targetRatio);
        mainScore += 1 - deviation;
        deviations.push({
            ingId: item.ingId,
            targetRatio,
            actualRatio,
            deviation,
            isOver: actualRatio > targetRatio
        });
    });
    
    mainScore = Math.max(0, (mainScore / recipe.main.length) * 100);
    
    // 盐得分
    const { min, max } = getSaltMinMax(recipe, totalActual);
    let saltScore = 0;
    if (currentSalt >= min && currentSalt <= max) {
        const ideal = (min + max) / 2;
        saltScore = 100 - (Math.abs(currentSalt - ideal) / ((max - min) || 0.1)) * 100;
    } else {
        saltScore = 30;
    }
    
    return {
        total: Math.round(mainScore * 0.7 + saltScore * 0.3),
        mainScore: Math.round(mainScore),
        saltScore: Math.round(saltScore),
        deviations
    };
}

function checkShortage() {
    const recipe = findRecipe(selectedDishId);
    if (!recipe) return { ok: true, msg: '' };
    
    let shortages = [];
    for (let item of recipe.main) {
        const required = item.target;
        const stdWeight = ITEM_WEIGHT[item.ingId] || 100;
        const requiredUnits = Math.ceil(required / stdWeight);
        const available = inventory[item.ingId] || 0;
        if (available < requiredUnits) {
            shortages.push(`${getIngredientName(item.ingId)} 缺 ${requiredUnits - available}个`);
        }
    }
    
    if (shortages.length > 0) {
        shortageWarning.innerText = '⚠️ 食材不足：' + shortages.join('，');
        return { ok: false, msg: shortages.join('，') };
    } else {
        shortageWarning.innerText = '';
        return { ok: true, msg: '' };
    }
}

function consumeInventory(recipe) {
    for (let item of recipe.main) {
        const required = item.target;
        const stdWeight = ITEM_WEIGHT[item.ingId] || 100;
        const requiredUnits = Math.ceil(required / stdWeight);
        inventory[item.ingId] = (inventory[item.ingId] || 0) - requiredUnits;
    }
}

function calculateEarning(recipe, score) {
    const basePrice = (recipe.basePriceCN || 30) * 10;
    return Math.round(basePrice * (score / 100));
}

function generateAdvice(scoreResult) {
    if (scoreResult.total >= 90) return '✨ 完美！配方已解锁 ✨';
    
    let advice = [];
    
    // 主料建议
    scoreResult.deviations.forEach(dev => {
        const ingName = getIngredientName(dev.ingId);
        if (dev.deviation > 0.15) {
            if (dev.isOver) {
                advice.push(`${ingName} 偏多`);
            } else {
                advice.push(`${ingName} 偏少`);
            }
        } else if (dev.deviation > 0.08) {
            if (dev.isOver) {
                advice.push(`${ingName} 稍多`);
            } else {
                advice.push(`${ingName} 稍少`);
            }
        }
    });
    
    // 盐的建议
    const recipe = findRecipe(selectedDishId);
    const total = calcTotalMainWeight(recipe);
    const { min, max } = getSaltMinMax(recipe, total);
    if (currentSalt < min - 0.5) {
        advice.push('盐太少');
    } else if (currentSalt > max + 0.5) {
        advice.push('盐太多');
    } else if (currentSalt < min) {
        advice.push('盐稍少');
    } else if (currentSalt > max) {
        advice.push('盐稍多');
    }
    
    if (advice.length === 0) {
        return '比例接近了，再微调一下';
    }
    
    return '⚠️ ' + advice.join('，');
}

