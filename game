    timeDisplay.innerText = timeStr;
    
    const open = isBusinessHours();
    businessStatus.innerText = open ? '🟢 营业中' : '🔴 已打烊';
    businessStatus.className = 'business-status ' + (open ? 'open' : '');
    
    currencyDisplay.innerText = `💰 ${gold} ${getCurrencyName()}`;
    
    if (period !== currentPricePeriod) {
        refreshMerchantPrices();
        renderMerchant();
    }
    merchantTimeBadge.innerText = period === 'morning' ? '(上午价格)' : '(下午价格)';
}

function clearGuestDisplay() {
    currentGuest = null;
    guestEmoji.innerText = '😶';
    guestWant.innerText = '👋 等待客人';
    guestOrderDish.innerText = '—';
}

// =============================================================================
// 12. 存档系统
// =============================================================================
function saveGame() {
    try {
        localStorage.setItem(SAVE_KEYS.inventory, JSON.stringify(inventory));
        localStorage.setItem(SAVE_KEYS.gold, gold.toString());
        localStorage.setItem(SAVE_KEYS.unlockedRecipes, JSON.stringify(unlockedRecipes));
        localStorage.setItem(SAVE_KEYS.dailyStatus, JSON.stringify(dailyStatus));
        localStorage.setItem(SAVE_KEYS.immersiveMode, immersiveMode.toString());
        localStorage.setItem(SAVE_KEYS.customerQueue, JSON.stringify(customerQueue));
    } catch (e) {
        console.warn('存档失败', e);
    }
}

function loadGame() {
    try {
        const savedInventory = localStorage.getItem(SAVE_KEYS.inventory);
        if (savedInventory) inventory = JSON.parse(savedInventory);
        
        const savedGold = localStorage.getItem(SAVE_KEYS.gold);
        if (savedGold) gold = parseInt(savedGold);
        
        const savedUnlocked = localStorage.getItem(SAVE_KEYS.unlockedRecipes);
        if (savedUnlocked) unlockedRecipes = JSON.parse(savedUnlocked);
        
        const savedDaily = localStorage.getItem(SAVE_KEYS.dailyStatus);
        if (savedDaily) dailyStatus = JSON.parse(savedDaily);
        
        const savedImmersive = localStorage.getItem(SAVE_KEYS.immersiveMode);
        if (savedImmersive) immersiveMode = savedImmersive === 'true';
        
        const savedQueue = localStorage.getItem(SAVE_KEYS.customerQueue);
        if (savedQueue) customerQueue = JSON.parse(savedQueue);
    } catch (e) {
        console.warn('读档失败，使用初始值', e);
    }
}

// =============================================================================
// 13. 初始化
// =============================================================================
function init() {
    loadGame();
    
    const today = getCurrentTime().dateStr;
    if (dailyStatus.date !== today) {
        dailyStatus.date = today;
        dailyStatus.specialId = RECIPES[Math.floor(Math.random() * RECIPES.length)].id;
        dailyStatus.completed = false;
    }
    
    if (Object.keys(inventory).length === 0) {
        inventory = {
            tomato: 20, egg: 50, potato: 15, beef: 5, cucumber: 10,
            flour: 10, shrimp: 5, corn: 10, chicken: 5, onion: 15,
            cheese: 8, rice: 8, riceNoodle: 6
        };
    }
    
    toggleImmersiveBtn.innerText = immersiveMode ? '🌌 沉浸模式' : '🌍 普通模式';
    toggleImmersiveBtn.classList.toggle('immersive', immersiveMode);
    
    const specialRecipe = findRecipe(dailyStatus.specialId);
    if (specialRecipe) dailySpecialName.innerText = getDisplayName(specialRecipe);
    
    const recipe = findRecipe(selectedDishId);
    setMainAmountsRandom(recipe);
    resetSaltToMid();
    
    refreshMerchantPrices();
    initCustomerQueue();
    startSpawnTimer();
    
    renderMenu();
    renderIngredientSliders();
    renderRecipeList();
    renderInventory();
    renderMerchant();
    updateStatusBar();
    clearGuestDisplay();
    checkShortage();
    
    toggleImmersiveBtn.addEventListener('click', () => {
        immersiveMode = !immersiveMode;
        saveGame();
        toggleImmersiveBtn.innerText = immersiveMode ? '🌌 沉浸模式' : '🌍 普通模式';
        toggleImmersiveBtn.classList.toggle('immersive', immersiveMode);
        renderMenu();
        if (currentGuest) {
            const gr = findRecipe(currentGuest.dishId);
            if (gr) guestOrderDish.innerText = getDisplayName(gr);
        }
        const sr = findRecipe(dailyStatus.specialId);
        if (sr) dailySpecialName.innerText = getDisplayName(sr);
        const cr = findRecipe(selectedDishId);
        if (cr) cookedDishName.innerText = getDisplayName(cr);
        renderInventory();
        renderMerchant();
        updateStatusBar();
    });
    
    cancelGuestBtn.addEventListener('click', () => {
        if (guestTimeout) clearTimeout(guestTimeout);
        clearGuestDisplay();
    });
    
    newGuestBtn.addEventListener('click', () => {
        if (!isBusinessHours()) {
            alert('现在不是营业时间');
            return;
        }
        if (customerQueue.length === 0) {
            alert('暂时没有客人排队');
            return;
        }
        const next = takeNextCustomer();
        if (next) {
            currentGuest = next;
            guestEmoji.innerText = '😀';
            guestWant.innerText = '我想吃...';
            guestOrderDish.innerText = immersiveMode ? next.immersiveName : next.dishName;
        }
    });
    
    saltSlider.addEventListener('input', e => {
        currentSalt = parseFloat(e.target.value);
        saltValueDisplay.innerText = currentSalt.toFixed(1);
    });
    
    cookAndServeBtn.addEventListener('click', () => {
        const recipe = findRecipe(selectedDishId);
        if (!recipe) return;
        
        const shortage = checkShortage();
        if (!shortage.ok) {
            alert('食材不足，无法烹饪');
            return;
        }
        
        const scoreResult = calculateScore(recipe);
        const score = scoreResult.total;
        const feedback = score >= 90 ? '✨ 完美!' : score >= 80 ? '👍 不错' : score >= 60 ? '👌 还可以' : '😕 继续努力';
        
        consumeInventory(recipe);
        const earning = calculateEarning(recipe, score);
        gold += earning;
        
        dishEmoji.innerText = recipe.emoji;
        cookedDishName.innerText = getDisplayName(recipe);
        cookedFeedback.innerText = feedback;
        scoreDisplay.innerText = score;
        
        // 生成详细建议
        adviceText.innerText = generateAdvice(scoreResult);
        
        if (score >= 90 && !unlockedRecipes[recipe.id]) {
            unlockedRecipes[recipe.id] = true;
            renderRecipeList();
            if (recipe.storyCN) storyFragment.innerText = '📖 ' + recipe.storyCN;
        }
        
        if (currentGuest) {
            if (recipe.id === currentGuest.dishId) {
                guestWant.innerText = `评价: ${feedback}  +${earning}💰`;
                guestOrderDish.innerText = `得分 ${score}`;
                guestEmoji.innerText = score >= 60 ? '😁' : '😐';
            } else {
                guestWant.innerText = '我点的不是这个...';
                guestOrderDish.innerText = `我要 ${getDisplayName(findRecipe(currentGuest.dishId))}`;
                guestEmoji.innerText = '😤';
            }
        } else {
            guestWant.innerText = `练习模式  +${earning}💰`;
            guestOrderDish.innerText = '无客人';
        }
        
        saveGame();
        updateStatusBar();
        renderInventory();
        renderMerchant();
        renderIngredientSliders();
        updateSaltSlider();
        checkShortage();
    });
    
    setInterval(() => {
        updateStatusBar();
    }, 60000);
}

init();
</script>
