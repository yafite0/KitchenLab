<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>厨房实验室</title>
    <style>
        /* ========== 样式区 ========== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        body {
            background: #2b2b1f;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 8px;
        }
        .game-container {
            width: 100%;
            max-width: 520px;
            background: #4a3a2a;
            border-radius: 40px 40px 30px 30px;
            box-shadow: 0 20px 30px rgba(0,0,0,0.6);
            padding: 16px 12px 20px;
            border: 3px solid #6b4f35;
            position: relative;
        }

        /* 顶部信息栏 */
        .top-bar {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 16px;
        }
        .status-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #6b5238;
            border-radius: 60px;
            padding: 8px 16px;
            border: 2px solid #ac8b60;
            box-shadow: inset 0 -3px 0 #3d2e1b;
        }
        .business-status {
            font-weight: 700;
            font-size: 16px;
            padding: 4px 12px;
            border-radius: 30px;
            background: #3d2e1b;
            color: #ffdcaa;
        }
        .business-status.open {
            background: #2d6a4f;
            color: #e9ffdb;
        }
        .currency-display {
            background: #b59d6b;
            border-radius: 40px;
            padding: 6px 16px;
            font-weight: 800;
            color: #2d2a17;
            font-size: 18px;
        }
        .time-display {
            color: #ffe5b9;
            font-size: 14px;
        }
        .feature-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #6b5238;
            border-radius: 60px;
            padding: 8px 12px;
            border: 2px solid #ac8b60;
            box-shadow: inset 0 -3px 0 #3d2e1b;
        }
        .toggle-btn {
            background: #947b58;
            border: 2px solid #e7c594;
            border-radius: 40px;
            padding: 8px 16px;
            font-size: 16px;
            font-weight: 700;
            color: #ffebc0;
            box-shadow: 0 3px 0 #5d422b;
            cursor: pointer;
            transition: 0.02s;
        }
        .toggle-btn:active {
            transform: translateY(3px);
            box-shadow: 0 0 0 #5d422b;
        }
        .toggle-btn.immersive {
            background: #b59d6b;
            color: #2d2a17;
        }
        .daily-special {
            background: #8b6f4c;
            border-radius: 40px;
            padding: 8px 16px;
            border: 2px solid #dbb47a;
            font-weight: 600;
            color: #fff1c1;
        }
        .daily-special span {
            color: #ffb347;
            font-size: 18px;
            margin-left: 6px;
        }

        /* 顾客区域 */
        .guest-area {
            background: #8b6f4c;
            padding: 16px 12px 12px;
            border-radius: 50px 50px 25px 25px;
            box-shadow: inset 0 -5px 0 #5d3e25, 0 8px 0 #3d2e1b;
            margin-bottom: 16px;
            border: 2px solid #b99e7c;
        }
        .guest-row {
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .guest-emoji {
            background: #f0dbb4;
            width: 70px;
            height: 70px;
            border-radius: 50px 50px 25px 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 50px;
            box-shadow: 0 6px 0 #8b6f4c, 0 8px 8px rgba(0,0,0,0.3);
            border: 3px solid #ffcf9a;
        }
        .guest-bubble {
            flex: 1;
            background: #fff9e6;
            border-radius: 35px 35px 35px 8px;
            padding: 10px 14px;
            border: 3px solid #dbb47a;
            box-shadow: 0 4px 0 #997b56;
        }
        .order-text {
            font-size: 15px;
            font-weight: bold;
            color: #3a2c1c;
        }
        .order-name {
            font-size: 22px;
            font-weight: 800;
            color: #a1521d;
            margin-top: 2px;
        }
        .queue-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 8px;
            padding: 0 4px;
            color: #ffe5b9;
            font-size: 14px;
        }
        .queue-count {
            background: #3d2e1b;
            padding: 4px 12px;
            border-radius: 30px;
            font-weight: 700;
        }
        .action-buttons {
            display: flex;
            gap: 10px;
            margin-top: 12px;
        }
        .btn {
            flex: 1;
            background: #f5c284;
            border: none;
            border-radius: 40px;
            padding: 14px 0;
            font-size: 20px;
            font-weight: 800;
            color: #3e2c16;
            box-shadow: 0 5px 0 #b27d48, 0 4px 8px black;
            transition: 0.05s linear;
            text-align: center;
            cursor: pointer;
            border: 2px solid #ffdaa0;
        }
        .btn:active { transform: translateY(4px); box-shadow: 0 1px 0 #b27d48; }
        .btn.secondary { background: #cfb28b; box-shadow: 0 5px 0 #8e6f47; }
        .btn.disabled {
            opacity: 0.5;
            pointer-events: none;
            filter: grayscale(0.5);
        }
        .btn.cook-serve {
            background: #a5d6a5;
            box-shadow: 0 5px 0 #5f8b5f;
            color: #1d3a1d;
            border-color: #c0ebc0;
            font-size: 24px;
            padding: 18px 0;
            width: 100%;
            margin: 8px 0 4px;
        }

        /* 左右双列 */
        .row-split {
            display: flex;
            gap: 8px;
            margin-bottom: 16px;
            min-height: 150px;
        }
        .menu-col {
            flex: 1.2;
            background: #6b5238;
            border-radius: 30px;
            padding: 10px 6px;
            border: 2px solid #ac8b60;
            box-shadow: inset 0 0 8px #2f2419;
            overflow-y: auto;
            max-height: 180px;
        }
        .menu-title {
            color: #ffdcaa;
            font-weight: 700;
            font-size: 15px;
            text-align: center;
            margin-bottom: 6px;
        }
        .menu-item {
            background: #947b58;
            margin: 5px 0;
            padding: 8px 4px;
            border-radius: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 2px solid #c9a15b;
            box-shadow: 0 3px 0 #5d422b;
            cursor: pointer;
            font-weight: 700;
            font-size: 15px;
            color: #23200e;
            text-align: center;
        }
        .menu-item.selected {
            background: #ffbc6e;
            border-color: #fff3b3;
            box-shadow: 0 3px 0 #a56e31;
        }

        .recipe-col {
            flex: 1;
            background: #5f4a32;
            border-radius: 30px;
            padding: 10px 6px;
            border: 2px solid #b39263;
            box-shadow: inset 0 0 6px #20180f;
            overflow-y: auto;
            max-height: 180px;
        }
        .recipe-title {
            color: #ffda9e;
            font-weight: 700;
            font-size: 15px;
            text-align: center;
            margin-bottom: 6px;
        }
        .recipe-item {
            background: #7c6446;
            margin: 5px 0;
            padding: 8px 6px;
            border-radius: 25px;
            border: 1px solid #ccaa73;
            color: #f7efd6;
            font-size: 13px;
            font-weight: 500;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: 0.1s;
        }
        .recipe-item.locked {
            opacity: 0.5;
            background: #5d4b36;
            filter: grayscale(0.6);
            cursor: default;
            pointer-events: none;
        }
        .recipe-item.unlocked {
            background: #9b855d;
            border-color: #ffdd99;
        }
        .recipe-item.unlocked:active {
            transform: scale(0.98);
            background: #b79b6b;
        }

        /* 库存面板 */
        .inventory-panel {
            background: #5f4630;
            border-radius: 30px;
            padding: 12px;
            margin: 16px 0 8px;
            border: 3px solid #ad8759;
        }
        .inventory-title {
            color: #ffda9e;
            font-weight: 700;
            font-size: 16px;
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        .inventory-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            max-height: 200px;
            overflow-y: auto;
        }
        .inventory-item {
            background: #7c6446;
            border-radius: 30px;
            padding: 8px 10px;
            display: flex;
            align-items: center;
            gap: 6px;
            border: 1px solid #ccaa73;
            color: #f7efd6;
            font-size: 14px;
        }
        .inventory-item .count {
            font-weight: 800;
            color: #ffd966;
            margin-left: auto;
        }

        /* 进货商面板 */
        .merchant-panel {
            background: #5f4630;
            border-radius: 30px;
            padding: 12px;
            margin: 16px 0 8px;
            border: 3px solid #ad8759;
        }
        .merchant-title {
            color: #ffda9e;
            font-weight: 700;
            font-size: 16px;
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
        }
        .merchant-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            max-height: 200px;
            overflow-y: auto;
        }
        .merchant-item {
            background: #7c6446;
            border-radius: 30px;
            padding: 8px 10px;
            display: flex;
            align-items: center;
            gap: 6px;
            border: 1px solid #ccaa73;
            color: #f7efd6;
            font-size: 14px;
            cursor: pointer;
        }
        .merchant-item:active {
            background: #9b855d;
        }
        .merchant-item .price {
            font-weight: 800;
            color: #ffd966;
            margin-left: auto;
        }
        .merchant-item.disabled {
            opacity: 0.5;
            pointer-events: none;
        }

        /* 厨房操作区 */
        .counter {
            background: #bd9a6b;
            border-radius: 35px 35px 20px 20px;
            padding: 16px 12px;
            box-shadow: inset 0 -5px 0 #7e5d38, 0 8px 0 #4f3a24;
            border: 2px solid #e7c594;
            margin-top: 4px;
        }
        .panel {
            background: #5f4630;
            border-radius: 30px;
            padding: 14px 12px;
            border: 3px solid #ad8759;
            box-shadow: inset 0 0 5px #2b1f12;
        }
        .ingredient-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 12px 0;
        }
        .ingr-emoji {
            background: #ecdbb9;
            width: 46px;
            height: 46px;
            border-radius: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            border: 2px solid #c9a769;
            box-shadow: 0 3px 0 #836e48;
            flex-shrink: 0;
        }
        .slider-box {
            flex: 4;
            min-width: 160px;
        }
        .slider-label {
            display: flex;
            justify-content: space-between;
            color: #ffebc0;
            font-weight: 600;
            margin-bottom: 4px;
            font-size: 14px;
        }
        .slider-label .range-hint {
            color: #ffd966;
            font-size: 12px;
        }
        .current-hint {
            color: #ffd0a0;
            font-size: 12px;
            margin-left: 4px;
        }
        input[type=range] {
            width: 100%;
            height: 16px;
            background: #eec18e;
            border-radius: 20px;
            -webkit-appearance: none;
            appearance: none;
            box-shadow: inset 0 2px 5px #413222;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 32px;
            height: 32px;
            background: #fff5d0;
            border-radius: 50%;
            border: 3px solid #b1530f;
            box-shadow: 0 3px 0 #6b3c12;
            cursor: pointer;
        }
        .salt-area {
            background: #847054;
            border-radius: 30px;
            padding: 12px 10px;
            margin: 12px 0 6px;
            border: 2px solid #cfa66b;
        }
        .salt-row {
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .total-info {
            color: #ffe5b9;
            font-weight: 600;
            font-size: 15px;
            margin-top: 8px;
            text-align: right;
        }
        .shortage-warning {
            background: #9d4e4e;
            border-radius: 20px;
            padding: 6px 12px;
            margin: 8px 0;
            color: #ffebc0;
            font-size: 14px;
            border-left: 5px solid #ff8a8a;
        }
        .story-fragment {
            background: #3d2e1b;
            border-radius: 20px;
            padding: 8px 12px;
            margin: 10px 0 5px;
            color: #ffdbb5;
            font-size: 14px;
            font-style: italic;
            border-left: 5px solid #b48b4b;
        }
        .advice-box {
            background: #3d3426;
            border-radius: 30px;
            padding: 8px 12px;
            margin: 10px 0 0;
            color: #ffdcaa;
            font-size: 14px;
            border: 1px solid #b48b4b;
        }
        .plate {
            background: #e0d3bc;
            border-radius: 80px 80px 40px 40px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 14px;
            border: 4px solid #ae9472;
            box-shadow: 0 6px 0 #6c5a41;
            margin-top: 12px;
        }
        .dish-icon {
            background: #cf5e2a;
            width: 64px;
            height: 64px;
            border-radius: 50% 50% 30% 30%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
            border: 3px solid #ffb156;
            box-shadow: inset 0 -5px 0 #863d14;
        }
        .dish-meta { flex: 1; }
        .dish-name { font-size: 22px; font-weight: 800; color: #1e2f1c; }
        .feedback { color: #f9ffd6; background: #4e6b3d; padding: 6px 10px; border-radius: 30px; font-size: 16px; font-weight: 600; display: inline-block; }
        .score-badge { background: #ffeeab; padding: 6px 10px; border-radius: 40px; font-weight: 800; font-size: 26px; color: #003f1f; border: 2px solid gold; }
        
        /* 评分区域 - 现在在按钮下方 */
        .score-section {
            margin: 8px 0 4px;
        }
        
        /* 版权声明 */
        .copyright {
            text-align: center;
            color: #8b7a5a;
            font-size: 12px;
            margin-top: 16px;
            padding-top: 8px;
            border-top: 1px solid #6b5a3a;
        }
        .footer-notes { color: #bba16f; text-align: center; margin-top: 8px; font-size: 12px; }
    </style>
</head>
<body>
<div class="game-container">
    <!-- 顶部信息栏 -->
    <div class="top-bar">
        <div class="status-row">
            <div class="business-status" id="businessStatus">🕒 营业中</div>
            <div class="currency-display" id="currencyDisplay">💰 0 金币</div>
            <div class="time-display" id="timeDisplay">12:00</div>
        </div>
        <div class="feature-row">
            <div class="toggle-btn" id="toggleImmersiveBtn">🌍 普通模式</div>
            <div class="daily-special" id="dailySpecialDisplay">今日特供 <span id="dailySpecialName">—</span></div>
        </div>
    </div>

    <!-- 顾客区 -->
    <div class="guest-area">
        <div class="guest-row">
            <div class="guest-emoji" id="guestEmoji">😶</div>
            <div class="guest-bubble">
                <div class="order-text" id="guestWant">👋 等待客人</div>
                <div class="order-name" id="guestOrderDish">—</div>
            </div>
        </div>
        <div class="queue-info">
            <span>📋 排队人数:</span>
            <span class="queue-count" id="queueCount">0</span>
        </div>
        <div class="action-buttons">
            <button class="btn" id="newGuestBtn">🔔 接客</button>
            <button class="btn secondary small" id="cancelGuestBtn">✖ 中断</button>
        </div>
    </div>

    <!-- 左右双列 -->
    <div class="row-split">
        <div class="menu-col" id="menuList"></div>
        <div class="recipe-col" id="recipeList"></div>
    </div>

    <!-- 厨房操作区 -->
    <div class="counter">
        <div class="panel">
            <div id="ingredientSliders"></div>

            <div class="salt-area">
                <div class="salt-row">
                    <div class="ingr-emoji">🧂</div>
                    <div class="slider-box">
                        <div class="slider-label">
                            <span>盐 (g) <span class="range-hint" id="saltRangeHint"></span></span>
                            <span><span class="current-hint">当前</span> <span id="saltValueDisplay">0.0</span></span>
                        </div>
                        <input type="range" id="saltSlider" min="0" max="20" value="0" step="0.1">
                    </div>
                </div>
                <div class="total-info" id="totalMainWeight">食材总重: 0g</div>
            </div>

            <div id="shortageWarning" class="shortage-warning"></div>
            <button class="btn cook-serve" id="cookAndServeBtn">🍳 烹饪并上菜</button>
            
            <!-- 评分区 - 现在紧贴按钮下方 -->
            <div class="score-section">
                <div class="plate" style="margin-top:0;">
                    <div class="dish-icon" id="dishEmoji">🍳</div>
                    <div class="dish-meta">
                        <div class="dish-name" id="cookedDishName">—</div>
                        <div class="feedback" id="cookedFeedback">等待烹饪</div>
                    </div>
                    <div class="score-badge" id="scoreDisplay">-</div>
                </div>
            </div>

            <!-- 提示区 -->
            <div class="advice-box" id="adviceText">调整比例，争取高分解锁配方</div>
            
            <!-- 故事碎片 - 移到了最下面 -->
            <div id="storyFragment" class="story-fragment"></div>
        </div>
    </div>

    <!-- 库存面板 -->
    <div class="inventory-panel">
        <div class="inventory-title">
            <span>📦 库存</span>
            <span id="totalInventoryValue">总价值: --</span>
        </div>
        <div class="inventory-grid" id="inventoryGrid"></div>
    </div>

    <!-- 进货商面板 -->
    <div class="merchant-panel">
        <div class="merchant-title">
            <span>🛒 进货商 <span id="merchantTimeBadge">(上午价格)</span></span>
            <span id="merchantHint">点击购买(5个/份)</span>
        </div>
        <div class="merchant-grid" id="merchantGrid"></div>
    </div>

    <!-- 版权声明 -->
    <div class="copyright">
        游戏设计 · 凌霄云弈 | 感谢您的试玩
    </div>
</div>

<script>
// =============================================================================
// 厨房实验室 - 修复版
// =============================================================================
// 游戏设计、数值平衡、测试：凌霄云弈
// 代码辅助：Deepseek
// =============================================================================

// =============================================================================
// 1. 全局配置
// =============================================================================
const GAME_CONFIG = {
    businessHours: { start: 6, end: 21 },
    currencyName: {
        normal: '金币',
        immersive: '哈塞盾'
    },
    customerSpawn: {
        intervalMinutes: 3,
        maxQueueSize: 10,
        offlineMax: 10,
        offlineThresholdMinutes: 30
    },
    initialGold: 5000,
    purchaseQuantity: 5  // 每次购买5个
};

// =============================================================================
// 2. 食材库 (普通模式 + 沉浸模式名称)
// =============================================================================
const INGREDIENTS = {
    tomato: { nameCN: '番茄', nameIM: '红果', emoji: '🍅' },
    egg: { nameCN: '鸡蛋', nameIM: '羽兽蛋', emoji: '🥚' },
    potato: { nameCN: '土豆', nameIM: '土苓', emoji: '🥔' },
    beef: { nameCN: '牛肉', nameIM: '地行兽肉', emoji: '🥩' },
    cucumber: { nameCN: '黄瓜', nameIM: '青瓜', emoji: '🥒' },
    flour: { nameCN: '面粉', nameIM: '精磨粉', emoji: '🌾' },
    shrimp: { nameCN: '虾', nameIM: '晶壳虫', emoji: '🦐' },
    corn: { nameCN: '玉米', nameIM: '金粒', emoji: '🌽' },
    chicken: { nameCN: '鸡肉', nameIM: '羽兽肉', emoji: '🐔' },
    onion: { nameCN: '洋葱', nameIM: '晶衣鳞茎', emoji: '🧅' },
    cheese: { nameCN: '奶酪', nameIM: '凝乳精块', emoji: '🧀' },
    rice: { nameCN: '米饭', nameIM: '珍珠米', emoji: '🍚' },
    riceNoodle: { nameCN: '河粉', nameIM: '玉带粉', emoji: '🍜' }
};

// =============================================================================
// 3. 菜品库
// =============================================================================
const RECIPES = [
    {
        id: 'scrambledEgg',
        nameCN: '番茄炒蛋',
        nameImmersive: '红果金丝',
        emoji: '🍳🍅',
        storyCN: '将蛋液如金丝般注入沸水，配以细碎的红果粒，熬成一碗浓醇的汤羹。',
        main: [
            { ingId: 'tomato', target: 200 },
            { ingId: 'egg', target: 150 }
        ],
        saltRange: [0.01, 0.02],
        basePriceCN: 18
    },
